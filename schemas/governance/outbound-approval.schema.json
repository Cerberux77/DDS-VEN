{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dds.smsmantis.local/schemas/governance/outbound-approval.schema.json",
  "title": "DDS Sensitive Outbound Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "draftId", "approved", "actor", "approvedAt", "evidence"],
  "properties": {
    "kind": {
      "enum": ["ECONOMIC", "LEGAL", "CONTRACT", "AFE", "PARTNER_COMMITMENT"]
    },
    "draftId": { "type": "string", "minLength": 1 },
    "approved": { "const": true },
    "actor": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "evidence": { "type": "string", "minLength": 1 }
  }
}
