{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dds.smsmantis.local/schemas/governance/document-record.schema.json",
  "title": "DDS Drive Document Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "driveFileId",
    "canonicalPath",
    "version",
    "modifiedTime",
    "hash",
    "documentType",
    "status",
    "gitPolicy",
    "relatedModelInput",
    "relatedRelease"
  ],
  "properties": {
    "driveFileId": { "type": "string", "minLength": 1 },
    "canonicalPath": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "null"] },
    "modifiedTime": { "type": "string", "format": "date-time" },
    "hash": { "type": ["string", "null"] },
    "documentType": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["CURRENT", "APPROVED", "CANDIDATE", "DRAFT", "BLOCKED_EXTERNAL", "SUPERSEDED", "ARCHIVE"]
    },
    "gitPolicy": {
      "enum": ["METADATA_ONLY", "NORMALIZED_INPUT", "DERIVED_ARTIFACT", "DO_NOT_COPY"]
    },
    "relatedModelInput": { "type": ["string", "null"] },
    "relatedRelease": { "type": ["string", "null"] }
  }
}
