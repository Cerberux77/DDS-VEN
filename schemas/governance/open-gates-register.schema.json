{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dds.smsmantis.local/schemas/governance/open-gates-register.schema.json",
  "title": "DDS Open Gates Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "status",
          "owner",
          "blocking",
          "affectedOutputs",
          "nextAction",
          "requiredEvidence",
          "promotionCondition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G[0-9]{2}$"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "affectedOutputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextAction": {
            "type": "string"
          },
          "requiredEvidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "promotionCondition": {
            "type": "string"
          }
        }
      }
    }
  }
}
