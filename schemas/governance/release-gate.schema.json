{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dds.smsmantis.local/schemas/governance/release-gate.schema.json",
  "title": "DDS Governance Release Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["gateId", "required", "status", "evidence", "approvedBy", "approvedAt"],
  "properties": {
    "gateId": { "type": "string", "minLength": 1 },
    "required": { "type": "boolean" },
    "status": { "enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "WAIVED"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "approvedBy": { "type": ["string", "null"] },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
