# Neon pooled connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# At least 32 random bytes; signs the opaque session cookie.
DEALROOM_SESSION_SECRET=replace-with-long-random-secret
# Explicitly false in deployed environments. Demo mode uses seeded identities only for local UI validation.
DEALROOM_DEMO_MODE=false

# Optional notification webhook. Receives REGISTER / LOGIN / VIEW / download events as JSON.
ACCESS_NOTIFICATION_WEBHOOK=

# Optional direct transactional email delivery through Resend.
# All three values are required to enable direct email notifications.
RESEND_API_KEY=
ACCESS_NOTIFICATION_EMAIL=
ACCESS_NOTIFICATION_FROM=
